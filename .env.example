## ---- Frontend (public) ----
NEXT_PUBLIC_ENVIRONMENT="development"
NEXT_PUBLIC_CDN_BASE_URL="https://cdn.managerenta.com"
NEXT_PUBLIC_CDN_ASSETS_VERSION=""
NEXT_PUBLIC_GOOGLE_ANALYTIC_TRACKING_ID=""

# Leave empty so axios hits same-origin `/api/...`. Only set this if the
# frontend is deployed separately and must reach the backend cross-origin.
NEXT_PUBLIC_MAIN_SERVICE_URL=""

## ---- Server (private) ----
ENVIRONMENT="development"
NODE_ENV="development"
COOKIE_DOMAIN="localhost"

# Database
DB_NAME="maqamah"
MONGODB_URI="mongodb://127.0.0.1:27017"
REDIS_URI="redis://127.0.0.1:6379"

# API keys
ADMIN_API_KEY=""

# S3
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_ACCESS_KEY=""

# JWT
JWT_ACCESS_TOKEN_SECRET=""
JWT_REFRESH_TOKEN_SECRET=""

# Observability
METRICS_ENABLED="false"
