## ---- Frontend (public) ----
NEXT_PUBLIC_ENVIRONMENT="development"
NEXT_PUBLIC_CDN_BASE_URL="https://cdn.managerenta.com"
NEXT_PUBLIC_CDN_ASSETS_VERSION=""

## ---- Server (private) ----
NODE_ENV="development"
COOKIE_DOMAIN="localhost"

# Database
DB_NAME="managerenta"
MONGODB_URI="mongodb://127.0.0.1:27017"
REDIS_URI="redis://127.0.0.1:6379"

# S3
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_ACCESS_KEY=""

# JWT
JWT_ACCESS_TOKEN_SECRET=""
JWT_REFRESH_TOKEN_SECRET=""

# Observability
METRICS_ENABLED="false"
# REQUIRED to expose /api/metrics. Must be a strong random string; clients
# scrape with `Authorization: Bearer <METRICS_TOKEN>`. Leave empty to 404 the
# endpoint entirely.
METRICS_TOKEN=""

# Notifications — outbound delivery providers (optional).
# When unset, notifications log to stdout (dev behaviour). Set these to enable
# real delivery; each channel activates independently.
#   Email via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Managerenta <no-reply@managerenta.com>"
#   SMS / WhatsApp via Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# Web push (browser notifications + PWA). Generate a key pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL identifying the sender.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@managerenta.com"

# Network / trust boundary
# Set to "1" only when the app sits behind an edge proxy (ALB, CloudFront,
# Cloudflare) that overwrites x-real-ip / cf-connecting-ip with the true
# client IP. When unset, getClientIp() returns "unknown" — rate-limit keys
# fall back to the global bucket. See SECURITY_REVIEW.md H5.
TRUSTED_PROXY="0"
